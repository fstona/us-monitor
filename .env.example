# Copy this file to ".env" (same folder) and paste your keys after the "=".
# The .env file is gitignored and never committed.
FRED_API_KEY=
BEA_API_KEY=
# Optional: enables Claude tone/summaries + web search for Fed speakers (src/ingest/llm.py)
ANTHROPIC_API_KEY=
# Optional: BLS API v2 key (free) — raises limits to 50 series/query, 500 queries/day
BLS_API_KEY=
# Needed for the gasoline prior of the PCE nowcast (free): https://www.eia.gov/opendata/register.php
EIA_API_KEY=
